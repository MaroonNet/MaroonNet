# Terrain packages and mission stores are built or written locally, never committed.
# The root .gitignore ignores every folder named data/; re-include this one so its
# README and the claude/ and archive/ placeholders are tracked.
!data/
data/*
!data/README.md
!data/claude/
!data/archive/

# Frontend build output, once pmp/web/ has a build (R-10).
web/node_modules/
web/dist/

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.DS_Store
