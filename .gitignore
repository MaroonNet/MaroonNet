# Root .gitignore
# Each area (backend/*, frontend/*, ml) adds its own .gitignore when its stack is chosen.

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Per-person Claude files (the shared settings live in .claude/settings.json)
CLAUDE.local.md
.claude/settings.local.json

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
