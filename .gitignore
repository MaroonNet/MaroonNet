# Root ignores: secrets, per-person Claude files, OS and editor noise.
# Each area (backend/*, frontend/*, ml) has its own .gitignore for its language and build output.

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Per-person Claude files (the shared settings live in .claude/settings.json)
CLAUDE.local.md
.claude/settings.local.json

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
