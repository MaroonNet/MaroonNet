# Mission stores and synthetic data are rebuilt by the CLI, never committed.
# The root .gitignore ignores every folder named data/; re-include this one so its
# README and the claude/ and archive/ placeholders are tracked.
!data/
data/*
!data/README.md
!data/claude/
!data/archive/

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.DS_Store
