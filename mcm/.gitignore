# Radio captures and synthetic feeds are rebuilt or recorded locally, never committed.
# The root .gitignore ignores every folder named data/; re-include this one so its
# README and the claude/ and archive/ placeholders are tracked.
!data/
data/*
!data/README.md
!data/claude/
!data/archive/

# Radio captures anywhere in the package: positions of people in the field.
*.jsonl
!tests/fixtures/*.jsonl

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.DS_Store
